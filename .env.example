GROQ_API_KEY=your_groq_api_key_here
GEN_MODEL=llama-3.1-8b-instant
PORT=8787

# crawl scope / politeness
MAX_PAGES=40
MAX_DEPTH=3
CRAWL_CONCURRENCY=3
POLITENESS_DELAY_MS=500
REQUEST_TIMEOUT_MS=8000
MAX_LINKS_PER_PAGE=25
USER_AGENT=ChatWithSiteBot/1.0 (+take-home-assignment)

# chunking
CHUNK_WORDS=150
CHUNK_OVERLAP_WORDS=30

# retrieval / grounding
TOP_K=5
MIN_SCORE=0.10

# ChromaDB Config
CHROMA_URL=http://localhost:8000
CHROMA_TOKEN=
